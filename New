select case when tw.warranty_class is null then auto_select else 1 end as checkbox, 
   ISNULL(wc.component_code, ''), 
   wc.warranty_class, 
   isnull(tw.duration, wc.default_duration) as duration, 
   FORMAT(ISNULL(tw.meter, wc.default_meter), 'N0') AS meter,
   tw.warranty_type, 
   rtrim(COALESCE(tw.warranty_manufacturer, WC.warranty_vendor) + case when M.manufacturer = 'ALTEC' then ' * ' else ' - ' end + substring(dbo.sf_InitCaps(m.description), 1, 20)) as manufacturer, 
   ISNULL(wc.make + ' ', '') + tw.notes as notes, 
   case when tw.warranty_class is null then 0 else 1 end as db_checked, 
   ISNULL(wc.component_code, ''), 
   tw.warranty_class as db_warranty_class, 
   tw.duration as db_duration, 
   tw.meter, 
   tw.warranty_type, 
   rtrim(COALESCE(tw.warranty_manufacturer, WC.warranty_vendor) + case when M.manufacturer = 'ALTEC' then ' * ' else ' - ' end + substring(dbo.sf_InitCaps(m.description), 1, 20)) as manufacturer, 
   ISNULL(wc.make + ' ', '') + tw.notes as db_notes 
   , convert(varchar(16), tw.last_edited_on, 121) + ' ' + tw.last_edited_by as last_edited 
from WarrantyClasses wc 
  left outer join TemplateWarranties tw on tw.warranty_class = wc.warranty_class and tw.template = 014366
  left outer join Manufacturer M on M.manufacturer = COALESCE(tw.warranty_manufacturer, WC.warranty_vendor, WC.make) 
where isnull(wc.component_code, '') in ('', 'A', '') 
   AND wc.make = 'PTRBL'
order by ISNULL(wc.component_code, ''), wc.warranty_class 
