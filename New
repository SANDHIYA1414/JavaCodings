
CREATE TABLE Students (
    Id INT IDENTITY(1,1) PRIMARY KEY,
    Name NVARCHAR(100),
    Age INT,
    Email NVARCHAR(100)
);
GO

CREATE PROCEDURE GetAllStudents
AS
BEGIN
    SELECT * FROM Students;
END
GO

CREATE PROCEDURE AddStudent
    @Name NVARCHAR(100),
    @Age INT,
    @Email NVARCHAR(100)
AS
BEGIN
    INSERT INTO Students (Name, Age, Email)
    VALUES (@Name, @Age, @Email);
END
GO
