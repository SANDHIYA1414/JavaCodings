    //Validate bid count (Existing count + Submitted Count > Exempt count)
    public void ValidateBidCount(decimal rowcnt, string control)
    {

        decimal i = 0;



        while (i < rowcnt)
        {

            i++;
            string[] checkboxValues = Request.Form.GetValues(control + i.ToString());


            if (checkboxValues != null && checkboxValues.Length > 0)
            {

                string joinedValues = string.Join(", ", checkboxValues);


                if (!string.IsNullOrEmpty(joinedValues))
                {
                    if (control != "cancel")
                    {
                        submitted_bid_Count++;
                    }
                }
            }
            //if (System.String.Join(", ", Request.Form[control + i.ToString()]) != "") //ayg9
            //if (System.String.Join(", ", Request.Form.GetValues(control + i.ToString())) != "")  //ayg9

            //{
            //	if (control != "cancel")
            //	{
            //		submitted_bid_Count++;
            //	}
            //}
        }

        //Get Union Exempt Count
        GetUnionExemptCount();

        //Get existing bid count
        CheckBidNumber();

        //Set Total bid count
        Total_Bid_Count = ((decimal)Emp_Bid_Count) + submitted_bid_Count;

        if (Union_Exempt != "NoLimit")
        {
            if (Total_Bid_Count > Convert.ToInt16(Double.Parse(Union_Exempt)))
            {
                Bids_Allowed = "No";
            }
            else
            {
                Bids_Allowed = "Yes";
            }
        }
        else
        {
            Bids_Allowed = "Yes";
        }
