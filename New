        'Invoices with errors are set to statuscode=3, OK invoices are set to statuscode=5
        SQL = "EXEC ValidatePayments"
        cmd = New SqlCommand
        cmd.Connection = cn
        cmd.CommandText = SQL
        cmd.CommandTimeout = 480 'Due to timeout issue As per Mike Apr 21, 2020
        cmd.ExecuteNonQuery()

        wLog = fLog.AppendText
        wLog.WriteLine(Now() & Chr(9) & "EXEC ValidatePayments ran OK")
        wLog.Close()

        'Get invoice data where Invoice.StatusCode = 5 and InvoicePayment.SAPDate IS NULL and InvoicePayment.ApprovedDate IS NOT NULL
        'SQL = "SELECT ip.PaymentSeq, ip.InvoiceNumber, ip.RevLetterCode, ip.InvoiceAmt,ip.OrderNumber, ISNULL(ip.OrderOperation,'') as OrderOperation, ra.sSocialSec, i.ContractNumber, i.VendorNumber, i.PayDueDays, ip.LastModifiedDate, i.WeekEnding " &
        '    "FROM (InvoicePayment ip INNER JOIN Invoice i ON ip.InvoiceNumber = i.InvoiceNumber) INNER JOIN s_RecmdApprv ra ON ip.ApprovedBy = ra.sUser " &
        '    "WHERE i.StatusCode = 5 and ip.SAPDate IS 0NULL and ip.ApprovedDate IS NOT NULL and i.Source <> 'Z'"

        'Changes done to adde new field MSANumber by sqpx
        SQL = "SELECT ip.PaymentSeq, ip.InvoiceNumber, ip.RevLetterCode, ip.InvoiceAmt,ip.OrderNumber, ISNULL(ip.OrderOperation,'') as OrderOperation, ra.sSocialSec, i.ContractNumber, i.VendorNumber, i.PayDueDays, ip.LastModifiedDate, i.WeekEnding, ISNULL(CC.MSANumber,'') as MSAContractNUmber " &
            "FROM (InvoicePayment ip INNER JOIN Invoice i ON ip.InvoiceNumber = i.InvoiceNumber) INNER JOIN s_RecmdApprv ra ON ip.ApprovedBy = ra.sUser  left join CTMS.dbo.Contracts CC on i.ContractNumber=CC.contract_number " &
            "WHERE i.StatusCode = 5 and ip.SAPDate IS NULL and ip.ApprovedDate IS NOT NULL and i.Source <> 'Z' and i.WeekEnding >'1/1/2021' "

        cmd.CommandText = SQL
        dr = cmd.ExecuteReader()

        'Open file
        f = New FileInfo(OutputFile)
        w = f.CreateText()

        wLog = fLog.AppendText
        wLog.WriteLine(Now() & Chr(9) & "Opened " & OutputFile & " in directory " & f.DirectoryName)
        wLog.Close()

        'init
        recCount = 0
        totalAmount = 0
        netAmount = 0
        invoiceCount = 0

        'Write header record (001)
        w.WriteLine("001" & FileDescription.PadRight(10) & FileName.PadRight(44) & ProgramName & Format(Now(), "MMddyyyyHHmmss") & Space(321) & Space(8))
        recCount = recCount + 1

        If Not dr.IsClosed Then

            While dr.Read
                'Write data to file
                wLog = fLog.AppendText
                wLog.WriteLine(Now() & Chr(9) & dr("InvoiceNumber"))
                wLog.Close()

                'Check if credit or debit
                If dr("InvoiceAmt") < 0 Then
                    vendorKey = "21"
                    accountingKey = "50"
                    PayTerms = "PT10" 'Added for the changes requested by Mike on 10June2022.
                Else
                    vendorKey = "31"
                    accountingKey = "40"
                End If

                'Check if pre/post invoice
                If dr("WeekEnding") < PrePostDate Then
                    BlockInvoiceFlag = "Y"
                Else
                    BlockInvoiceFlag = " "      'Empty string same as NO
                End If

                'Calculate Due Date
                dueDate = DateAdd(DateInterval.Day, CInt(dr("PayDueDays")), CDate(dr("LastModifiedDate")))

                'Write Invoice record (002)                                 invoice(15)                             revcode(1)                                      doc-hdr-text
                w.WriteLine("002" & Format(Now(), "MMddyyyy") & DocType & CompanyCd & CStr(dr("InvoiceNumber")).PadRight(15) & CStr(dr("RevLetterCode")).PadRight(1) & Currency & CStr(dr("sSocialSec")).PadRight(25) & Space(339) & Space(8))
                recCount = recCount + 1
                invoiceCount = invoiceCount + 1

                'Write Vendor record (003)      key    vendorid(10)                     $amount to be paid                                                                                                      weekending?
                w.WriteLine("003" & vendorKey & CStr(dr("VendorNumber")).PadRight(10) & Format(Math.Abs(dr("InvoiceAmt")), "##########0.00").PadLeft(14) & "00000000000000" & "00000000000000" & PayTerms & Space(1) & Space(2) & Space(8) & Space(19) & "*" & CStr(dr("ContractNumber")).PadRight(49) & Space(35) & Space(35) & Space(35) & Space(35) & Space(35) & Space(35) & Space(3) & Space(10) & Country & Space(2) & Space(31) & Space(7) & BlockInvoiceFlag & CStr(dr("MSAContractNumber")).PadRight(20))
                'w.WriteLine("003" & vendorKey & CStr(dr("VendorNumber")).PadRight(10) & Format(Math.Abs(dr("InvoiceAmt")), "##########0.00").PadLeft(14) & "00000000000000" & "00000000000000" & PayTerms & Space(1) & Space(2) & Format(dueDate, "MMddyyyy") & Space(19) & "*" & CStr(dr("ContractNumber")).PadRight(49) & Space(35) & Space(35) & Space(35) & Space(35) & Space(35) & Space(35) & Space(3) & Space(10) & Country & Space(2) & Space(31) & Space(6) & BlockInvoiceFlag)
                recCount = recCount + 1
                totalAmount = totalAmount + Math.Abs(dr("InvoiceAmt"))
                netAmount = netAmount + dr("InvoiceAmt")


                'Write Accounting record (004)
                'w.WriteLine("004" & accountingKey & AccountNumber.PadRight(10) & Space(4) & Space(10) & Format(Math.Abs(dr("InvoiceAmt")), "##########0.00").PadLeft(14) & Space(18) & Space(50) & CStr(dr("OrderNumber")).PadRight(10) & Space(8) & Space(271))
                w.WriteLine("004" & accountingKey & AccountNumber.PadRight(10) & Space(4) & Space(10) & Format(Math.Abs(dr("InvoiceAmt")), "##########0.00").PadLeft(14) & Space(18) & Space(50) & CStr(dr("OrderNumber")).PadRight(12) & Space(8) & Space(2) & Space(15) & CStr(dr("OrderOperation")).PadRight(4) & Space(248) & Space(8))
                recCount = recCount + 1

            End While

            dr.Close()
        End If

        'Write Trailer record (999)
        recCount = recCount + 1
        w.WriteLine("999" & Format(recCount, "########0").PadLeft(9) & Format(totalAmount, "############0.00").PadLeft(16) & "0000000000000000" & CStr(Format(invoiceCount, "########0")).PadLeft(9) & Space(347) & Space(8))

        wLog = fLog.AppendText
        wLog.WriteLine(Now() & Chr(9) & CStr(invoiceCount) & " records written to file")
        wLog.WriteLine(Now() & Chr(9) & Format(totalAmount, "$#,##0.00") & " TOTAL dollars processed")
        wLog.WriteLine(Now() & Chr(9) & Format(netAmount, "$#,##0.00") & " NET dollars processed")
        wLog.Close()

        'testing - do not go beyond this point
        'Exit Sub

        'Mark records as processed
        SQL = "UPDATE InvoicePayment SET SAPDate = '" & Now() & "'" &
            "WHERE SAPDate IS NULL and ApprovedDate IS NOT NULL and InvoiceNumber IN( SELECT DISTINCT i.InvoiceNumber FROM Invoice i INNER JOIN InvoicePayment ip ON i.InvoiceNumber=ip.InvoiceNumber " &
            "WHERE i.StatusCode = 5 and ip.SAPDate IS NULL and ip.ApprovedDate IS NOT NULL and I.Source <> 'Z')"
        cmd.CommandText = SQL
        cmd.ExecuteNonQuery()

        SQL = "UPDATE Invoice SET StatusCode = 6 " &
            "WHERE InvoiceNumber IN( SELECT DISTINCT i.InvoiceNumber FROM Invoice i INNER JOIN InvoicePayment ip ON i.InvoiceNumber=ip.InvoiceNumber " &
            "WHERE i.StatusCode = 5 and ip.ApprovedDate IS NOT NULL and I.Source <> 'Z')"
        cmd.CommandText = SQL
        cmd.ExecuteNonQuery()

    Catch ex As Exception

        'Write to event log
        Dim fLog As New FileInfo(LogFile)
        Dim wLog As StreamWriter = fLog.AppendText()
        wLog.WriteLine(Now() & Chr(9) & "ERROR: " & ex.Message)
        wLog.Close()

        'Write to error log
        Dim fErr As New FileInfo(ErrFile)
        Dim wErr As StreamWriter = fErr.AppendText()
        wErr.WriteLine(Now() & Chr(9) & "ERROR: " & ex.Message)
        wErr.Close()

        Exit Sub

    Finally
        'Cleanup
        'cmd.Dispose()
        If w Is Nothing Then
            'Do nothing
        Else
            w.Close()
        End If

        If cn Is Nothing Then
            'do nothing
        Else
            cn.Close()
        End If

        'Open log file, if any
        If LogFile <> "" Then
            Dim fLog As New FileInfo(LogFile)  'logfile
            Dim wLog As StreamWriter = fLog.AppendText()
            wLog.WriteLine(Now() & Chr(9) & "Process finished")
            wLog.Close()
        End If
    End Try

End Sub
