   

            Dim exePath As String = System.IO.Path.GetDirectoryName(System.Reflection.Assembly.GetExecutingAssembly().Location)

Dim logDir As String = System.IO.Path.Combine(exePath, "Logs")

Dim DirCheck As New System.IO.DirectoryInfo(logDir)
If Not DirCheck.Exists Then
    DirCheck.Create()
End If

LogFile = System.IO.Path.Combine(logDir, Format(Now, "yyMMdd-HHmmss") & ".log")
ErrFile = System.IO.Path.Combine(logDir, Format(Now, "yyMMdd-HHmmss") & ".err")
