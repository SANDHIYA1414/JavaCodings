internal static void BuildInsert(ref string sSQL, string sField, string sDelimAndBlankOpt, string sValue)
		{

			if (Strings.Len(sSQL) == 0)
			{
				sSQL = " () " + mdlUtil_STD.NL + "select";
			}
			int iNextPos = (sSQL.IndexOf(')') + 1); //pos for next field to be inserted
			if (iNextPos == 0)
			{ //this is the typical way to begin a new Build insert
				sSQL = sSQL + " () " + mdlUtil_STD.NL + "select";
				iNextPos = (sSQL.IndexOf(')') + 1);
			}
			//NOW INSERT THE NEXT FIELD NAME
			if (sSQL.Substring(iNextPos - 2, Math.Min(1, sSQL.Length - (iNextPos - 2))) == "(")
			{
				sSQL = sSQL.Substring(0, Math.Min(iNextPos - 1, sSQL.Length)) + sField + sSQL.Substring(iNextPos - 1);
			}
			else
			{
				sSQL = sSQL.Substring(0, Math.Min(iNextPos - 1, sSQL.Length)) + ", " + sField + sSQL.Substring(iNextPos - 1);
			}
			string switchVar = sDelimAndBlankOpt.ToUpper();
			if (switchVar == mdlUtil_STD.QT || switchVar == mdlUtil_STD.HQ)
			{ //standard string - trim the value
				sValue = mdlUtil_STD.sQT(sValue);
			}
			else if (switchVar == "QTNULL")
			{  //standard string, but pass Null iF Blank
				if (sValue.Trim() == "")
				{
					sValue = "Null";
				}
				else
				{
					sValue = mdlUtil_STD.sQT(sValue);
				}
			}
			else if (switchVar == "NULL")
			{  // standard numeric - null if blank
				if (sValue == "")
				{
					sValue = "NULL";
				}
			}
			else if (switchVar == "0" || switchVar == "ZERO")
			{  // numeric - use val() of string
				if (Conversion.Val(sValue) == 0)
				{
					sValue = "0";
				}
			}
			else if (switchVar == "$")
			{  // money - use convert(money, value)
				sValue = "convert(money, " + mdlUtil_STD.sQT(sValue) + ")";
			}
			if (sSQL.Substring(Math.Max(sSQL.Length - 6, 0)) == "select")
			{
				sSQL = sSQL + mdlUtil_STD.NL + mdlUtil_STD.TB + sValue.Trim();
			}
			else
			{
				//MAV 10/16/1998 - Modified to eliminate need for static sLastField
				sSQL = sSQL + ", " + mdlUtil_STD.NL + mdlUtil_STD.TB + sValue.Trim();
			}
			sSQL = sSQL + " /* " + sField + " */ "; //put FIELD NAME in comments on same line as the value...



		}


