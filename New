insert into po_items  (request, step, po_no, line_item_no, item_type, amount, change_descr, entry_date, insert_complete) 
select
	sn.request /* request */ , 
	sn.step /* step */ , 
	sn.purchase_order /* po_no */ , 
	sn.purchase_group_item + /* line_item_no */ , 
	 /* item_type */ , 
	convert(money, '3.00') /* amount */ , 
	'' /* change_descr */ , 
	getdate() /* entry_date */ , 
	1 /* insert_complete */ 
from #order_batch ob, specs_tracking sn 
where ob.spec_serial = sn.spec_serial 
   and sn.eng_year = 2025	 and ob.group_no = 1 
