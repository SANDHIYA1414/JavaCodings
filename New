using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;
using System.Configuration;
using log4net;
using log4net.Config;
using System.IO;

namespace LogFile
{
    public class Logger
    {
        public static void LogError(object objMsg, Exception ex)
        {
            LogError(objMsg);
        }

        public static void LogInfo(string Message)
        {
            DateTime dt = new DateTime();
            try
            {
                Configuration config = ConfigurationManager.OpenExeConfiguration(ConfigurationUserLevel.None);
                var LogPath = config.AppSettings.Settings["LogPath"].Value;
                var filePATH = LogPath + "SAPInvoiceArchivalLog.txt";

                if (!(Directory.Exists(LogPath)))
                {
                    DirectoryInfo di = Directory.CreateDirectory(LogPath);

                }
                bool CheckFileExisitence = File.Exists(filePATH);
                if (CheckFileExisitence)
                {
                    dt = File.GetCreationTime(filePATH);
                    if (DateTime.Now.Date > dt.Date)
                    {
                        string newpath = filePATH + "." + DateTime.Now.Year + "-" + DateTime.Now.Month + "-" + (DateTime.Now.Day - 1);
                        System.IO.File.Move(filePATH, newpath);
                    }
                }
                using (StreamWriter file = File.AppendText(filePATH))
                {

                    file.WriteLine(DateTime.Now + "   INFO TOTL -    " + "  :{0}", Message);
                    // file.Flush();
                }


            }
            catch (Exception ex)
            {


            }
            finally
            {

            }

        }

        public static void LogDebug(string Message)
        {
            LogInfo(Message);
        }
        public static void LogError(object objMsg)
        {
            try
            {

                string dirPATH = System.Configuration.ConfigurationManager.AppSettings["Dir_Path"];
                string filePATH = System.Configuration.ConfigurationManager.AppSettings["LogPath"];
                if (!(Directory.Exists(dirPATH)))
                {
                    DirectoryInfo di = Directory.CreateDirectory(dirPATH);

                }

                using (StreamWriter file = File.AppendText(filePATH))
                {

                    file.WriteLine(DateTime.Now + "   INFO SAP Invoice -    " + "  :{0}", objMsg);
                    file.Flush();
                }


            }
            catch (Exception ex)
            {


            }
        }
    }
}
