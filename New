ALTER PROCEDURE [dbo].[update_SafetyDataPYFull]

AS
BEGIN

	-- SET NOCOUNT ON added to prevent extra result sets from
	-- interfering with SELECT statements.
	SET NOCOUNT ON

-- =============================================
-- Truncate prior year full safety data tables
-- =============================================

	TRUNCATE TABLE tbl_SafetyIncidentsPYFull

-- =============================================
-- Initialize variables
-- =============================================

	DECLARE @CurrYear int
	SET @CurrYear = 2025

	DECLARE @PriorYear int
	SET @PriorYear = @CurrYear - 1

	DECLARE @CurrMonth int
	SET @CurrMonth = MONTH(GETDATE())

	DECLARE @SnapshotCY date
	SET @SnapshotCY = concat(year(getdate()), '-', month(getdate()),'-01')

	DECLARE @SnapshotLY date
	SET @SnapshotLY = concat((year(getdate()) - 1), '-', month(getdate()),'-01')

-- =============================================
-- Create Temp tables to speed up process?
-- =============================================

	--PCC table

	IF OBJECT_ID('tempdb..#PCC') IS NOT NULL
	DROP TABLE #PCC

	SELECT *
	INTO #PCC
	FROM (SELECT *
		  FROM [pritinfdbswx158].[SafetyDashboard].[dbo].[vw_PCCHierarchy]
		  WHERE [Work Unit Group] IN ('Gas Operations', 'Operations Support')
		  OR [Work Unit] = 'Corporate Real Estate') P

	-- select * from #pcc

	IF OBJECT_ID('tempdb..#Incidents') IS NOT NULL
	DROP TABLE #Incidents

	SELECT *
	INTO #Incidents
	FROM (SELECT *
		  FROM [pritinfdbswx158].[SafetyDashboard].[dbo].[vw_SEMSIncidentsLOB]
		  WHERE YEAR([ClassificationDate]) = @PriorYear
		  AND [Snapshot] = @SnapshotCY)I

	--select * from #incidents

	IF OBJECT_ID('tempdb..#SEMSID') IS NOT NULL
	DROP TABLE #SEMSID

	SELECT *
	INTO #SEMSID
	FROM (SELECT SEMSID
		  FROM #Incidents
		  INNER JOIN #PCC ON #PCC.PCC = #Incidents.PCC) S


	IF OBJECT_ID('tempdb..#Details') IS NOT NULL
	DROP TABLE #Details

	SELECT *
	INTO #Details
	FROM (SELECT *
		  FROM [pritinfdbswx158].[SafetyDashboard].[dbo].[vw_SEMSDetails]
		  WHERE [SEMSID] IN (SELECT [SEMSID] FROM #SEMSID))D 

-- =============================================
-- Append data from safety server into individual tables
-- =============================================

----Update incidents-----------------------------------------------------------------------------------------------------------------

	INSERT INTO tbl_SafetyIncidentsPYFull ([SafetyIncPYFull_SEMSID]
										  ,[SafetyIncPYFull_Incident Date]
									
										  ,[SafetyIncPYFull_NPMVI]
										  ,[SafetyIncPYFull_LoadDt])
	SELECT   T1.[SEMSID]
			,T1.[IncidentDate] AS [Incident Date]
			,[WorkCareDate] AS [Case Report Date]
			,T1.[PCC]
			,T1.[SupervisorLANID]
			,T1.[SupervisorName]
			,T3.[LOB]
			,T3.[Work Unit Group]
			,T3.[Work Unit]
	
			,T1.[ClassificationDate]
			,[PMVIDate]
			,[SPMVIDate]
			,[OSHADate]
			,[RestrictedDutyDate]
			,[LWDDate]
			,[DARTDate]
			,CASE WHEN (T1.[Incident Type]='Selfcare' AND YEAR(T1.[IncidentDate])= @PriorYear AND [ValidTimelyRecord]=1) then 1 
				  WHEN (T1.[Incident Type] LIKE 'NonOSHADrVisit' AND T2.[NatureShort] NOT LIKE 'Confidential'AND YEAR(T1.[IncidentDate])=@PriorYear AND [ValidTimelyRecord]=1) then 1 
				  WHEN (T1.[Incident Type] = 'OSHA' AND YEAR(T1.[IncidentDate])=@PriorYear AND [ValidTimelyRecord]=1) THEN 1 
				  ELSE 0 END AS [SelfCare]
			,CASE WHEN T1.[IncidentDate]=[WORKCAREDATE] THEN 1 
				  WHEN T1.[IncidentDate]=DATEADD(day,-1,[WorkCareDate]) THEN 1  
		
			,CASE WHEN T1.[Incident Type] = 'DART' THEN 1 
				  ELSE NULL END AS [DART]
			,CASE WHEN [SIFClassification] = 'SIF Potential' THEN 1 
				  ELSE Null END AS [SIF P]
		    ,DATEPART(wk,T1.classificationdate) as [Classification Week]
			,CASE WHEN T1.[Incident Type] IN ('MVI','SNP') THEN 1 
				  ELSE NULL END AS [NPMVI]
			,getdate() as LoadDt
	FROM #Incidents T1
	LEFT JOIN #Details T2 ON T1.[SEMSID]=T2.[SEMSID]
	LEFT JOIN #PCC T3 ON T1.[PCC]=T3.[PCC]
	WHERE 1 = 1
	--AND YEAR(T1.[ClassificationDate]) = @PriorYear
	--AND T2.[NatureShort] NOT LIKE 'Confidential'
	AND (YEAR([WorkCareDate]) = @PriorYear OR [WorkCareDate] IS NULL)
	--AND T1.[Snapshot] = @SnapshotCY
	AND year(T1.[IncidentDate]) = @PriorYear

			
-- =============================================
-- Append SAP Audit log with log information
-- =============================================

	INSERT INTO DETEP.dbo.tbl_SAP_AuditLog (  SAPAudit_Table
											, SAPAudit_UpDateDt
											, SAPAudit_LANID, UpdateDate, ProcedureName)
	VALUES ( 'tbl_SafetyIncidentsPYFull ver: 02/28/2022'
		    , CONVERT(decimal(12, 7), GETDATE()) + 2 --convert this date numerical value to Excel Serial Number equivalent.
		    , UPPER(SYSTEM_USER), getdate(), OBJECT_NAME(@@PROCID))

-- =============================================
-- Send out notification email
-- =============================================

	DECLARE @EmailSubject AS varchar(230);
        set @EmailSubject = 'Safety Prior Year Full Data has been updated'

		EXEC msdb.dbo.sp_send_dbmail
		@profile_name = 'DETEP account',
		@recipients=N'NXLU@pge.com;JX3M@pge.com',
		@subject =@EmailSubject,
		@exclude_query_output = 1,
		@query_result_header = 1; 

	--EXEC update_SafetyDataPYFull


END

