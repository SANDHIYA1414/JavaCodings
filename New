Imports System.IO
Imports System.Data
Imports System.Data.SqlClient

Module modSAPInvoice

    'This program searches for payment records in InvoicePayment table
    'which are ready to send to SAP for payment processing.  Data is 
    'written to a file, which can then be FTP'd to SAP server
    '
    'Date:      Ver:    Change:
    '11/20/02   1.00    Original version
    '11/06/03   1.10    ??
    '01/03/06   1.11    ??
    '08/11/08   1.20    Added Order Operation code
    '                   Order Number now 10 char instead of 12
    '01/02/18   1.30    Added blank 6 char field to record type 003 from char 402-407
    '                   Added 1 char field to record type 003 at char 408 to indicate if invoice should be blocked
    '                   Added blank 7 char field at the end of other record types
    '                   Payment Due Date is now blanked out
    '01/22/2019 1.31    Fixed logic so that PRE invoices are blocked and POST are paid

    Sub Main()

        Dim OutputFile, LogFile, ErrFile As String
        Dim ConnectionName, ServerName, DatabaseName As String
        Dim Arg As String
        Dim SQL As String
        Dim dr As SqlDataReader
        Dim cmd As SqlCommand
        Dim cn As SqlConnection         'For datareader (select - looping through records)
        Dim f As FileInfo
        Dim w As StreamWriter
        Dim recCount As Integer
        Dim totalAmount As Decimal
        Dim netAmount As Decimal
        Dim invoiceCount As Integer
        Dim vendorKey As String
        Dim accountingKey As String
        Dim dueDate As DateTime
        Dim AccountNumber As String
        Dim CompanyCd As String
        Dim Country As String
        Dim Currency As String
        Dim DocType As String
        Dim FileDescription As String
        Dim FileName As String
        Dim PayTerms As String
        Dim ProgramName As String
        Dim PrePostDate As DateTime
        Dim BlockInvoiceFlag As String      'Y/N flag

        Try
            'Set pre/post date
            PrePostDate = "1/29/2019"   'Chapter 11 date

            'Read command line for output filename
            For Each Arg In Environment.GetCommandLineArgs
                'Check for filename
                If Arg.StartsWith("-F") Or Arg.StartsWith("-f") Then
                    OutputFile = Trim(Arg.Substring(2))
                End If

                'mdmk: Logfile now hard-codeded as yymmdd-hhmmss.log
                'If Arg.StartsWith("-L") Or Arg.StartsWith("-l") Then
                '    LogFile = Trim(Arg.Substring(2))
                'End If

                If Arg.StartsWith("-D") Or Arg.StartsWith("-d") Then
                    DatabaseName = Trim(Arg.Substring(2))
                End If

                If Arg.StartsWith("-S") Or Arg.StartsWith("-s") Then
                    ServerName = Trim(Arg.Substring(2))
                End If

                'Check for help prompt
                If Arg.StartsWith("-?") Or Arg.StartsWith("-h") Or Arg.StartsWith("-H") Then
                    Console.WriteLine("Format is: SAPInvoice -F<Filename> -S<Server> -D<Database> [-L]<Logfile>")
                    Console.WriteLine("-F<Filename>     Name of outputfile")
                    Console.WriteLine("-S<Server>       Server name of SQL server (7.0 or higher reqd.)")
                    Console.WriteLine("-D<Database>     Database name")
                    'Console.WriteLine("[-L]<Logfile>    Optional.  Name of file to monitor process")
                    'Logfile now hard-codeded as yymmdd-hhmmss.log
                    Console.WriteLine("-H or -?         Shows this dialog")
                    Console.WriteLine("")
                    Console.WriteLine("Example: SAPInvoice -Ssql001 -Dpubs -Fsapfile.out")
                    Console.WriteLine("Note that there are no spaces after the switch")
                    Exit Sub
                End If
            Next 'For Each Arg In Environment.GetCommandLineArgs

            'Print commandline syntax and exit if something is missing
            If OutputFile = "" Or ServerName = "" Or DatabaseName = "" Then
                Console.WriteLine("ERROR: Missing parameter")
                Console.WriteLine("Format is: SAPInvoice -F<Filename> -S<Server> -D<Database> [-L]<Logfile>")
                Console.WriteLine("-F<Filename>     Name of outputfile")
                Console.WriteLine("-S<Server>       Server name of SQL server (7.0 or higher reqd.)")
                Console.WriteLine("-D<Database>     Database name")
                'Console.WriteLine("[-L]<Logfile>    Optional.  Name of file to monitor process")
                Console.WriteLine("-H or -?         Shows this dialog")
                Console.WriteLine("")
                Console.WriteLine("Example: SAPInvoice -Ssql001 -Dpubs -Fsapfile.out")
                Console.WriteLine("Note that there are no spaces after the switch")
                Exit Sub
            End If

            'mdmk: Generate log file name as yymmdd-hhmmss.log
            'Check to make sure \Logs subdirectory exists, if not... create it
            Dim DirCheck As New System.IO.DirectoryInfo(".\Logs")
            If Not DirCheck.Exists Then
                DirCheck.Create()
            End If

            'Create log file name based on date-time
            LogFile = ".\Logs\" & Format(Now, "yyMMdd-HHmmss") & ".log"
            ErrFile = ".\Logs\" & Format(Now, "yyMMdd-HHmmss") & ".err"

            'Open log file
            Dim fLog As New FileInfo(LogFile)
            Dim fErr As New FileInfo(ErrFile)
            Dim wLog As StreamWriter
            Dim wErr As StreamWriter

            wLog = fLog.AppendText()
            wLog.WriteLine(Now() & Chr(9) & "Process started")
            wLog.Close()

            'Connect to database
            ConnectionName = "Data Source=" & ServerName & "; Integrated Security=SSPI; Initial Catalog=" & DatabaseName & ";"
            cn = New SqlConnection
            cn.ConnectionString = ConnectionName
            cn.Open()

            'Open log file, if any
            wLog = fLog.AppendText
            wLog.WriteLine(Now() & Chr(9) & "Connected to " & ServerName & " -> " & DatabaseName & " database")
            wLog.Close()

            'mdmk 5-5-03: added this section to fetch codes to be used in SAP file
            SQL = "SELECT DataValue as 'AccountNumber' FROM InvoiceFileSettings WHERE DataField='AccountNumber';"
            SQL = SQL & "SELECT DataValue as 'CompanyCd' FROM InvoiceFileSettings WHERE DataField='CompanyCd';"
            SQL = SQL & "SELECT DataValue as 'Country' FROM InvoiceFileSettings WHERE DataField='Country';"
            SQL = SQL & "SELECT DataValue as 'Currency' FROM InvoiceFileSettings WHERE DataField='Currency';"
            SQL = SQL & "SELECT DataValue as 'DocType' FROM InvoiceFileSettings WHERE DataField='DocType';"
            SQL = SQL & "SELECT DataValue as 'FileDescription' FROM InvoiceFileSettings WHERE DataField='FileDescription';"
            SQL = SQL & "SELECT DataValue as 'FileName' FROM InvoiceFileSettings WHERE DataField='FileName';"
            SQL = SQL & "SELECT DataValue as 'PayTerms' FROM InvoiceFileSettings WHERE DataField='PayTerms';"
            SQL = SQL & "SELECT DataValue as 'ProgramName' FROM InvoiceFileSettings WHERE DataField='ProgramName'"
            Dim cmdFileSettings As New SqlCommand(SQL, cn)
            cmdFileSettings.CommandTimeout = 120
            dr = cmdFileSettings.ExecuteReader

            If dr.Read Then
                AccountNumber = dr("AccountNumber")
                dr.NextResult()
            Else
                wLog = fLog.AppendText
                wLog.WriteLine(Now() & Chr(9) & "ABORT: Missing AccountNumber setting in InvoiceFileSettings table")
                wLog.Close()
                wErr = fErr.AppendText
                wErr.WriteLine(Now() & Chr(9) & "ABORT: Missing AccountNumber setting in InvoiceFileSettings table")
                wErr.Close()
                cn.Close()
                Exit Sub
            End If

            If dr.Read Then
                CompanyCd = dr("CompanyCd")
                dr.NextResult()
            Else
                wLog = fLog.AppendText
                wLog.WriteLine(Now() & Chr(9) & "ABORT: Missing CompanyCd setting in InvoiceFileSettings table")
                wLog.Close()
                wErr = fErr.AppendText
                wErr.WriteLine(Now() & Chr(9) & "ABORT: Missing CompanyCd setting in InvoiceFileSettings table")
                wErr.Close()

                cn.Close()
                Exit Sub
            End If

            If dr.Read Then
                Country = dr("Country")
                dr.NextResult()
            Else
                wLog = fLog.AppendText
                wLog.WriteLine(Now() & Chr(9) & "ABORT: Missing Country setting in InvoiceFileSettings table")
                wLog.Close()
                wErr = fErr.AppendText
                wErr.WriteLine(Now() & Chr(9) & "ABORT: Missing Country setting in InvoiceFileSettings table")
                wErr.Close()
                cn.Close()
                Exit Sub
            End If

            If dr.Read Then
                Currency = dr("Currency")
                dr.NextResult()
            Else
                wLog = fLog.AppendText
                wLog.WriteLine(Now() & Chr(9) & "ABORT: Missing Currency setting in InvoiceFileSettings table")
                wLog.Close()
                wErr = fErr.AppendText
                wErr.WriteLine(Now() & Chr(9) & "ABORT: Missing Currency setting in InvoiceFileSettings table")
                wErr.Close()
                cn.Close()
                Exit Sub
            End If

            If dr.Read Then
                DocType = dr("DocType")
                dr.NextResult()
            Else
                wLog = fLog.AppendText
                wLog.WriteLine(Now() & Chr(9) & "ABORT: Missing DocType setting in InvoiceFileSettings table")
                wLog.Close()
                wErr = fErr.AppendText
                wErr.WriteLine(Now() & Chr(9) & "ABORT: Missing DocType setting in InvoiceFileSettings table")
                wErr.Close()
                cn.Close()
                Exit Sub
            End If

            If dr.Read Then
                FileDescription = dr("FileDescription")
                dr.NextResult()
            Else
                wLog = fLog.AppendText
                wLog.WriteLine(Now() & Chr(9) & "ABORT: Missing FileDescription setting in InvoiceFileSettings table")
                wLog.Close()
                wErr = fErr.AppendText
                wErr.WriteLine(Now() & Chr(9) & "ABORT: Missing FileDescription setting in InvoiceFileSettings table")
                wErr.Close()
                cn.Close()
                Exit Sub
            End If

            If dr.Read Then
                FileName = dr("FileName")
                dr.NextResult()
            Else
                wLog = fLog.AppendText
                wLog.WriteLine(Now() & Chr(9) & "ABORT: Missing FileName setting in InvoiceFileSettings table")
                wLog.Close()
                wErr = fErr.AppendText
                wErr.WriteLine(Now() & Chr(9) & "ABORT: Missing FileName setting in InvoiceFileSettings table")
                wErr.Close()
                cn.Close()
                Exit Sub
            End If

            If dr.Read Then
                PayTerms = dr("PayTerms")
                dr.NextResult()
            Else
                wLog = fLog.AppendText
                wLog.WriteLine(Now() & Chr(9) & "ABORT: Missing PayTerms setting in InvoiceFileSettings table")
                wLog.Close()
                wErr = fErr.AppendText
                wErr.WriteLine(Now() & Chr(9) & "ABORT: Missing PayTerms setting in InvoiceFileSettings table")
                wErr.Close()
                cn.Close()
                Exit Sub
            End If

            If dr.Read Then
                ProgramName = dr("ProgramName")
            Else
                wLog = fLog.AppendText
                wLog.WriteLine(Now() & Chr(9) & "ABORT: Missing ProgramName setting in InvoiceFileSettings table")
                wLog.Close()
                wErr = fErr.AppendText
                wErr.WriteLine(Now() & Chr(9) & "ABORT: Missing ProgramName setting in InvoiceFileSettings table")
                wErr.Close()
                cn.Close()
                Exit Sub
            End If

            dr.Close()
            cmdFileSettings.Dispose()

            'Call SP to validate order numbers (ValidateOrderNumbers)
            'Invoices with errors are set to statuscode=3, OK invoices are set to statuscode=5
            SQL = "EXEC ValidatePayments"
            cmd = New SqlCommand
            cmd.Connection = cn
            cmd.CommandText = SQL
            cmd.CommandTimeout = 480 'Due to timeout issue As per Mike Apr 21, 2020
            cmd.ExecuteNonQuery()

            wLog = fLog.AppendText
            wLog.WriteLine(Now() & Chr(9) & "EXEC ValidatePayments ran OK")
            wLog.Close()

            'Get invoice data where Invoice.StatusCode = 5 and InvoicePayment.SAPDate IS NULL and InvoicePayment.ApprovedDate IS NOT NULL
            'SQL = "SELECT ip.PaymentSeq, ip.InvoiceNumber, ip.RevLetterCode, ip.InvoiceAmt,ip.OrderNumber, ISNULL(ip.OrderOperation,'') as OrderOperation, ra.sSocialSec, i.ContractNumber, i.VendorNumber, i.PayDueDays, ip.LastModifiedDate, i.WeekEnding " &
            '    "FROM (InvoicePayment ip INNER JOIN Invoice i ON ip.InvoiceNumber = i.InvoiceNumber) INNER JOIN s_RecmdApprv ra ON ip.ApprovedBy = ra.sUser " &
            '    "WHERE i.StatusCode = 5 and ip.SAPDate IS 0NULL and ip.ApprovedDate IS NOT NULL and i.Source <> 'Z'"

            'Changes done to adde new field MSANumber by sqpx
            SQL = "SELECT ip.PaymentSeq, ip.InvoiceNumber, ip.RevLetterCode, ip.InvoiceAmt,ip.OrderNumber, ISNULL(ip.OrderOperation,'') as OrderOperation, ra.sSocialSec, i.ContractNumber, i.VendorNumber, i.PayDueDays, ip.LastModifiedDate, i.WeekEnding, ISNULL(CC.MSANumber,'') as MSAContractNUmber " &
                "FROM (InvoicePayment ip INNER JOIN Invoice i ON ip.InvoiceNumber = i.InvoiceNumber) INNER JOIN s_RecmdApprv ra ON ip.ApprovedBy = ra.sUser  left join CTMS.dbo.Contracts CC on i.ContractNumber=CC.contract_number " &
                "WHERE i.StatusCode = 5 and ip.SAPDate IS NULL and ip.ApprovedDate IS NOT NULL and i.Source <> 'Z' and i.WeekEnding >'1/1/2021' "

            cmd.CommandText = SQL
            dr = cmd.ExecuteReader()

            'Open file
            f = New FileInfo(OutputFile)
            w = f.CreateText()

            wLog = fLog.AppendText
            wLog.WriteLine(Now() & Chr(9) & "Opened " & OutputFile & " in directory " & f.DirectoryName)
            wLog.Close()

            'init
            recCount = 0
            totalAmount = 0
            netAmount = 0
            invoiceCount = 0

            'Write header record (001)
            w.WriteLine("001" & FileDescription.PadRight(10) & FileName.PadRight(44) & ProgramName & Format(Now(), "MMddyyyyHHmmss") & Space(321) & Space(8))
            recCount = recCount + 1

            If Not dr.IsClosed Then

                While dr.Read
                    'Write data to file
                    wLog = fLog.AppendText
                    wLog.WriteLine(Now() & Chr(9) & dr("InvoiceNumber"))
                    wLog.Close()

                    'Check if credit or debit
                    If dr("InvoiceAmt") < 0 Then
                        vendorKey = "21"
                        accountingKey = "50"
                        PayTerms = "PT10" 'Added for the changes requested by Mike on 10June2022.
                    Else
                        vendorKey = "31"
                        accountingKey = "40"
                    End If

                    'Check if pre/post invoice
                    If dr("WeekEnding") < PrePostDate Then
                        BlockInvoiceFlag = "Y"
                    Else
                        BlockInvoiceFlag = " "      'Empty string same as NO
                    End If

                    'Calculate Due Date
                    dueDate = DateAdd(DateInterval.Day, CInt(dr("PayDueDays")), CDate(dr("LastModifiedDate")))

                    'Write Invoice record (002)                                 invoice(15)                             revcode(1)                                      doc-hdr-text
                    w.WriteLine("002" & Format(Now(), "MMddyyyy") & DocType & CompanyCd & CStr(dr("InvoiceNumber")).PadRight(15) & CStr(dr("RevLetterCode")).PadRight(1) & Currency & CStr(dr("sSocialSec")).PadRight(25) & Space(339) & Space(8))
                    recCount = recCount + 1
                    invoiceCount = invoiceCount + 1

                    'Write Vendor record (003)      key    vendorid(10)                     $amount to be paid                                                                                                      weekending?
                    w.WriteLine("003" & vendorKey & CStr(dr("VendorNumber")).PadRight(10) & Format(Math.Abs(dr("InvoiceAmt")), "##########0.00").PadLeft(14) & "00000000000000" & "00000000000000" & PayTerms & Space(1) & Space(2) & Space(8) & Space(19) & "*" & CStr(dr("ContractNumber")).PadRight(49) & Space(35) & Space(35) & Space(35) & Space(35) & Space(35) & Space(35) & Space(3) & Space(10) & Country & Space(2) & Space(31) & Space(7) & BlockInvoiceFlag & CStr(dr("MSAContractNumber")).PadRight(20))
                    'w.WriteLine("003" & vendorKey & CStr(dr("VendorNumber")).PadRight(10) & Format(Math.Abs(dr("InvoiceAmt")), "##########0.00").PadLeft(14) & "00000000000000" & "00000000000000" & PayTerms & Space(1) & Space(2) & Format(dueDate, "MMddyyyy") & Space(19) & "*" & CStr(dr("ContractNumber")).PadRight(49) & Space(35) & Space(35) & Space(35) & Space(35) & Space(35) & Space(35) & Space(3) & Space(10) & Country & Space(2) & Space(31) & Space(6) & BlockInvoiceFlag)
                    recCount = recCount + 1
                    totalAmount = totalAmount + Math.Abs(dr("InvoiceAmt"))
                    netAmount = netAmount + dr("InvoiceAmt")


                    'Write Accounting record (004)
                    'w.WriteLine("004" & accountingKey & AccountNumber.PadRight(10) & Space(4) & Space(10) & Format(Math.Abs(dr("InvoiceAmt")), "##########0.00").PadLeft(14) & Space(18) & Space(50) & CStr(dr("OrderNumber")).PadRight(10) & Space(8) & Space(271))
                    w.WriteLine("004" & accountingKey & AccountNumber.PadRight(10) & Space(4) & Space(10) & Format(Math.Abs(dr("InvoiceAmt")), "##########0.00").PadLeft(14) & Space(18) & Space(50) & CStr(dr("OrderNumber")).PadRight(12) & Space(8) & Space(2) & Space(15) & CStr(dr("OrderOperation")).PadRight(4) & Space(248) & Space(8))
                    recCount = recCount + 1

                End While

                dr.Close()
            End If

            'Write Trailer record (999)
            recCount = recCount + 1
            w.WriteLine("999" & Format(recCount, "########0").PadLeft(9) & Format(totalAmount, "############0.00").PadLeft(16) & "0000000000000000" & CStr(Format(invoiceCount, "########0")).PadLeft(9) & Space(347) & Space(8))

            wLog = fLog.AppendText
            wLog.WriteLine(Now() & Chr(9) & CStr(invoiceCount) & " records written to file")
            wLog.WriteLine(Now() & Chr(9) & Format(totalAmount, "$#,##0.00") & " TOTAL dollars processed")
            wLog.WriteLine(Now() & Chr(9) & Format(netAmount, "$#,##0.00") & " NET dollars processed")
            wLog.Close()

            'testing - do not go beyond this point
            'Exit Sub

            'Mark records as processed
            SQL = "UPDATE InvoicePayment SET SAPDate = '" & Now() & "'" &
                "WHERE SAPDate IS NULL and ApprovedDate IS NOT NULL and InvoiceNumber IN( SELECT DISTINCT i.InvoiceNumber FROM Invoice i INNER JOIN InvoicePayment ip ON i.InvoiceNumber=ip.InvoiceNumber " &
                "WHERE i.StatusCode = 5 and ip.SAPDate IS NULL and ip.ApprovedDate IS NOT NULL and I.Source <> 'Z')"
            cmd.CommandText = SQL
            cmd.ExecuteNonQuery()

            SQL = "UPDATE Invoice SET StatusCode = 6 " &
                "WHERE InvoiceNumber IN( SELECT DISTINCT i.InvoiceNumber FROM Invoice i INNER JOIN InvoicePayment ip ON i.InvoiceNumber=ip.InvoiceNumber " &
                "WHERE i.StatusCode = 5 and ip.ApprovedDate IS NOT NULL and I.Source <> 'Z')"
            cmd.CommandText = SQL
            cmd.ExecuteNonQuery()

        Catch ex As Exception

            'Write to event log
            Dim fLog As New FileInfo(LogFile)
            Dim wLog As StreamWriter = fLog.AppendText()
            wLog.WriteLine(Now() & Chr(9) & "ERROR: " & ex.Message)
            wLog.Close()

            'Write to error log
            Dim fErr As New FileInfo(ErrFile)
            Dim wErr As StreamWriter = fErr.AppendText()
            wErr.WriteLine(Now() & Chr(9) & "ERROR: " & ex.Message)
            wErr.Close()

            Exit Sub

        Finally
            'Cleanup
            'cmd.Dispose()
            If w Is Nothing Then
                'Do nothing
            Else
                w.Close()
            End If

            If cn Is Nothing Then
                'do nothing
            Else
                cn.Close()
            End If

            'Open log file, if any
            If LogFile <> "" Then
                Dim fLog As New FileInfo(LogFile)  'logfile
                Dim wLog As StreamWriter = fLog.AppendText()
                wLog.WriteLine(Now() & Chr(9) & "Process finished")
                wLog.Close()
            End If
        End Try

    End Sub

End Module
