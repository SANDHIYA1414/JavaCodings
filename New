public void mnuHAUpdate_Click(Object eventSender, EventArgs eventArgs)
		{
			ADMIN.EditAdmin(Path.GetFileNameWithoutExtension(Application.ExecutablePath));
		}


internal static void EditAdmin(string sApp)
		{


			mdlUtil_ADO.gbSQLSkipError = -1;
			CheckAdminDB();

			//mdlUtil_STD.gsTmp = "select rtrim(key_code) , rtrim(userid) , rtrim(string_value), 99 ";
			//mdlUtil_STD.gsTmp = "select rtrim(key_code) + ' ' + rtrim(userid) + ' ' + rtrim(string_value)"; //MIAK
			mdlUtil_STD.gsTmp = "select rtrim(key_code) + '  \t' + rtrim(userid) + '  \t' + rtrim(string_value)"; //MIAK
			mdlUtil_STD.bs(ref mdlUtil_STD.gsTmp, "from " + msUtilDB + "..admin where appname = " + mdlUtil_STD.sQT(sApp));
			mdlUtil_STD.gsTmp = mdlUtil_ADO.sGetListInput(mdlUtil_ADO.goConn, "admin Table Entries", "Select an Entry to Edit", mdlUtil_STD.gsTmp);
			if (mdlUtil_STD.gsTmp == "" || mdlUtil_STD.gbCancel)
			{
				return;
			}
			//string sKey = mdlUtil_STD.sParseIt(mdlUtil_STD.gsTmp, mdlUtil_STD.TB, 1).Trim(); //key_code value  for item being edited
			//string sUser = mdlUtil_STD.sParseIt(mdlUtil_STD.gsTmp, mdlUtil_STD.TB, 2).Trim(); //userid value for item being edited
			//string sValue = mdlUtil_STD.sParseIt(mdlUtil_STD.gsTmp, mdlUtil_STD.TB, 3).Trim(); //string value
			string[] parts = mdlUtil_STD.gsTmp.Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries); //MIAK
			if (parts.Length < 3)
			{
				string tempnum = mdlUtil_STD.sGetInput("Update " , "Enter new value for this admin table entry.", "").Trim();

				return;
			}


			// Extract key, user, and value
			string sKey = parts[0].Trim();  // key_code value //MIAK
			string sUser = parts[1].Trim(); // userid value //MIAK
			string sValue = string.Join("\t", parts.Skip(2)).Trim(); // Combine remaining parts for string_value //MIAK

			sValue = mdlUtil_STD.sGetInput("Update " + mdlUtil_STD.sQT(sKey) + "  for " + mdlUtil_STD.sQT(sUser), "Enter new value for this admin table entry.", sValue).Trim();
			if (sValue == Strings.Chr(0).ToString() || mdlUtil_STD.gbCancel)
			{
				return;
			}

			if (sValue == "DELETE")
			{
				if (System.Windows.Forms.DialogResult.OK == MessageBox.Show("Delete key: " + sKey, "DELETE KEY", MessageBoxButtons.OKCancel))
				{
					mdlUtil_ADO.sql = "delete from admin where appName = " + mdlUtil_STD.sQT(sApp);
					mdlUtil_STD.bs(ref mdlUtil_ADO.sql, "   and userid = " + mdlUtil_STD.sQT(sUser) + " and key_code = " + mdlUtil_STD.sQT(sKey));
					mdlUtil_STD.giRes = mdlUtil_ADO.iSQL_DO(mdlUtil_ADO.goConn, mdlUtil_ADO.sql);
					EditAdmin(sApp);
				}
				return;
			}

			SetAppAdmin(Path.GetFileNameWithoutExtension(Application.ExecutablePath), sKey, sUser, sValue);

		}


internal static void SetAppAdmin(string sAppName, string sKey, string sID, string sValue)
		{


			mdlUtil_STD.glRes = mdlUtil_STD.iReplaceStr(ref sValue, mdlUtil_STD.QT, "`"); //prevent sql error on full quote conflict
			mdlUtil_STD.glRes = mdlUtil_STD.iReplaceStr(ref sValue, mdlUtil_STD.HQ, "`"); //prevent sql error on half quote conflict

			string sCmd = "delete from " + mdlUtil_ADO.gsDBNameOpt + "admin ";
			sCmd = sCmd + " where ";
			sCmd = sCmd + "appname = " + mdlUtil_STD.sQT(sAppName) + " and ";
			if (mdlUtil_ADO.gsDBType == "ORACLE")
			{
				sCmd = sCmd + "key = " + mdlUtil_STD.sQT(sKey) + " and ";
			}
			else
			{
				sCmd = sCmd + "key_code = " + mdlUtil_STD.sQT(sKey) + " and ";
			}
			sCmd = sCmd + "userid = " + mdlUtil_STD.sQT(sID);
			mdlUtil_STD.glRes = mdlUtil_ADO.SQL_DO(mdlUtil_ADO.goConn, ref sCmd);

			sCmd = "insert into " + mdlUtil_ADO.gsDBNameOpt + "admin values ( ";
			sCmd = sCmd + mdlUtil_STD.sQT(sAppName) + ", ";
			sCmd = sCmd + mdlUtil_STD.sQT(sKey) + ", ";
			sCmd = sCmd + mdlUtil_STD.sQT(sID) + ", ";
			sCmd = sCmd + mdlUtil_STD.sQT(sValue) + ") ";
			mdlUtil_STD.glRes = mdlUtil_ADO.SQL_DO(mdlUtil_ADO.goConn, ref sCmd);
		}
