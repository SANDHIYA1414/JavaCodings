string sql = @"
INSERT INTO po_items (request, step, po_no, line_item_no, item_type, amount, change_descr, entry_date, insert_complete)
SELECT
    sn.request,
    sn.step,
    sn.purchase_order,
    sn.purchase_group_item + " + sItemType + @",
    " + sItemType + @",
    CONVERT(money, " + sAmt + @"),
    '" + mdlUtil_STD.HQ + @"',
    GETDATE(),
    1
FROM #order_batch ob
INNER JOIN specs_tracking sn ON ob.spec_serial = sn.spec_serial
WHERE sn.eng_year = " + mdlApplication.gsEngYear + @"
AND ob.group_no = 1;";
