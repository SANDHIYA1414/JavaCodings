using Microsoft.AspNetCore.Mvc.Filters;
using Microsoft.Extensions.Logging;
using System;

namespace YourProjectNamespace.Filters
{
    public class CustomLogFilter : IActionFilter
    {
        private readonly ILogger<CustomLogFilter> _logger;

        public CustomLogFilter(ILogger<CustomLogFilter> logger)
        {
            _logger = logger;
        }

        public void OnActionExecuting(ActionExecutingContext context)
        {
            _logger.LogInformation($"[Before] Executing: {context.ActionDescriptor.DisplayName} at {DateTime.Now}");
        }

        public void OnActionExecuted(ActionExecutedContext context)
        {
            _logger.LogInformation($"[After] Executed: {context.ActionDescriptor.DisplayName} at {DateTime.Now}");
        }
    }
}
